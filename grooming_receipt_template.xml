<t t-name="grooming.report_grooming_receipt">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.basic_layout">
                        <div class="page" style="font-family: monospace; font-size: 13px; width: 100%; padding: 0; margin: 0; color: #000;">
                            <!-- Header -->
                            <div class="text-center" style="margin-bottom: 10px;">
                                <div t-if="env.company.logo" style="margin-bottom: 5px;">
                                    <img t-att-src="image_data_uri(env.company.logo)" style="max-height: 80px; max-width: 100%;" alt="Company Logo"/>
                                </div>
                                <h3 t-if="not env.company.logo" style="margin: 0; font-weight: bold; font-size: 18px;"><span t-esc="env.company.name"/></h3>
                                <div style="font-size: 11px;">
                                    <t t-if="env.company.street"><span t-esc="env.company.street"/><br/></t>
                                    <t t-if="env.company.street2"><span t-esc="env.company.street2"/><br/></t>
                                    <t t-if="env.company.city"><span t-esc="env.company.city"/></t>
                                    <t t-if="env.company.state_id">, <span t-esc="env.company.state_id.name"/></t>
                                    <t t-if="env.company.country_id">, <span t-esc="env.company.country_id.name"/></t>
                                    <br t-if="env.company.city or env.company.state_id"/>
                                    <t t-if="env.company.phone">Tel: <span t-esc="env.company.phone"/><br/></t>
                                    <t t-if="env.company.email">Email: <span t-esc="env.company.email"/></t>
                                </div>
                                <div style="border-bottom: 1px dashed #000; margin-top: 5px; margin-bottom: 5px;"/>
                                <h4 style="margin: 0; font-weight: bold; font-size: 15px;">GROOMING RECEIPT</h4>
                            </div>

                            <!-- Receipt Info -->
                            <div style="margin-bottom: 10px; font-size: 12px; line-height: 1.2;">
                                <strong>Receipt No:</strong> <span t-field="o.name"/><br/>
                                <strong>Date:</strong> <span t-field="o.appointment_date" t-options="{&quot;widget&quot;: &quot;date&quot;}"/><br/>
                                <strong>Customer:</strong> <span t-field="o.partner_id"/><br/>
                                <strong>Phone:</strong> <span t-field="o.customer_phone"/><br/>
                                <strong>Pet Name:</strong> <span t-field="o.pet_name"/><br/>
                                <strong>Species:</strong> <span t-field="o.pet_type"/><br/>
                                <strong>Size/Age:</strong> <span t-field="o.pet_category"/><br/>
                                <strong>Status:</strong> <span t-field="o.state"/>
                            </div>

                            <div style="border-bottom: 1px dashed #000; margin-bottom: 5px;"/>

                            <!-- Service Details Table -->
                            <table style="width: 100%; font-size: 12px; margin-bottom: 5px; border-collapse: collapse; border: none;">
                                <thead>
                                    <tr>
                                        <th style="text-align: left; padding-bottom: 3px; border-bottom: 1px dashed #000; font-weight: bold;">Description</th>
                                        <th style="text-align: right; padding-bottom: 3px; border-bottom: 1px dashed #000; font-weight: bold;">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="o.sale_order_id">
                                        <t t-foreach="o.sale_order_id.order_line" t-as="line">
                                            <tr>
                                                <td style="text-align: left; padding: 4px 0;">
                                                    <span t-field="line.name"/>
                                                </td>
                                                <td style="text-align: right; padding: 4px 0;">
                                                    <span t-esc="'{:,.0f}'.format(line.price_subtotal)"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </tbody>
                            </table>

                            <div style="border-bottom: 1px dashed #000; margin-bottom: 5px;"/>

                            <!-- Total -->
                            <table style="width: 100%; font-size: 14px; font-weight: bold; margin-bottom: 10px; border: none;">
                                <tr>
                                    <td style="text-align: left;">TOTAL</td>
                                    <td style="text-align: right;">TZS <span t-esc="'{:,.0f}'.format(o.total_price)"/></td>
                                </tr>
                            </table>

                            <!-- Payment Info -->
                            <div style="text-align: center; margin-top: 5px; font-weight: bold; font-size: 13px;">
                                <t t-if="o.appt_payment_status == 'paid'">
                                    *** PAID ***
                                    <div t-if="o.appt_payment_method" style="font-size: 11px; font-weight: normal; margin-top: 3px;">
                                        Payment Method: <span t-field="o.appt_payment_method"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    *** NOT PAID ***
                                </t>
                            </div>

                            <!-- QR Code and Footer -->
                            <div class="text-center" style="margin-top: 15px; text-align: center;">
                                <div style="border-bottom: 1px dashed #000; margin-bottom: 10px;"/>
                                
                                <img src="data:image/png;base64," style="width: 120px; height: 120px; margin: 0 auto; display: block;" alt="QR Code"/>
                                
                                <p style="font-size: 11px; margin-top: 10px; font-weight: bold;">Thank you for choosing Stephan's Pet Store!</p>
                                <p style="font-size: 10px;"><t t-if="env.company.website" t-esc="env.company.website"/><t t-else="">www.stephanspetstore.co.tz</t></p>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </t>